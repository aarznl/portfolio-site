---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectRow from '../../components/ProjectRow.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const allTags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();
---

<Base title="Projects" description="Mechatronics, robotics, and embedded systems projects.">
  <section class="page">
    <h1>Projects</h1>
    <p class="muted">An index of things I've designed and built.</p>

    <div class="filters mono" role="group" aria-label="Filter by tag">
      <button data-tag="" aria-pressed="true">all</button>
      {allTags.map((tag) => (
        <button data-tag={tag} aria-pressed="false">
          {tag}
        </button>
      ))}
    </div>

    <div class="section-head">
      <span class="label">No. / Project</span>
      <span class="label">Year</span>
    </div>
    <ul id="project-list">
      {projects.map((project, i) => <ProjectRow project={project} index={i} />)}
    </ul>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const rows = document.querySelectorAll<HTMLElement>('#project-list li');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const tag = button.dataset.tag ?? '';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      rows.forEach((row) => {
        const tags = (row.dataset.tags ?? '').split(',');
        row.hidden = tag !== '' && !tags.includes(tag);
      });
    });
  });
</script>

<style>
  .page {
    padding-top: 3.5rem;
  }

  h1 {
    font-size: clamp(1.6rem, 4vw, 2.1rem);
    margin: 0 0 0.5rem;
  }

  .page > p {
    margin: 0;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 2.5rem 0 2rem;
  }

  .filters button {
    font: inherit;
    font-size: 0.8rem;
    color: var(--muted);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .filters button:hover {
    color: var(--text);
  }

  .filters button[aria-pressed='true'] {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  ul {
    margin: 0;
    padding: 0;
  }

  :global([hidden]) {
    display: none !important;
  }
</style>
