---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="page">
    <p class="label">Error 404</p>
    <h1>This page doesn't exist.</h1>
    <p><a href="/">← back home</a></p>
  </section>
</Base>

<style>
  .page {
    padding-block: 5rem;
  }

  h1 {
    font-size: clamp(1.6rem, 4vw, 2.1rem);
    margin: 0.5rem 0 1.5rem;
  }
</style>
