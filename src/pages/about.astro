---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import headshot from '../assets/about/headshot.png';

// Edit these lists to match your background.
const research = [
  {
    title: 'Haptic Feedback for Robotic Surgery',
    org: 'UCLA Center for Advanced Surgical & Interventional Technology (CASIT), Dr. Rory Geoghegan',
    orgUrl: 'https://www.uclahealth.org/departments/surgery/casit',
    period: 'Mar 2023 – May 2025',
    text: 'Incorporated fiber Bragg grating (FBG) sensing into surgical forceps to detect tissue stiffness, giving surgeons haptic feedback during robotic surgery on the da Vinci Si. I created the FBG sensor manufacturing protocol (PDMS, 3D-printed molds, and epoxy), gathered grasping data on a custom bench-top rig with optical encoders, and found a way past the da Vinci’s magnetic and inductive barriers so our custom forceps could be used in human-operated experiments. Co-first author on the poster “Characterizing Robotic Surgery Instrument Kinematics When Under Human Control” at UCLA Bioengineering Research Day 2024.',
  },
  {
    title: 'Deep Learning for Knee MRI Segmentation',
    org: 'UCLA Magnetic Resonance Research Labs, Dr. Holden Wu',
    orgUrl: 'https://mrrl.ucla.edu/pages/',
    period: 'Sept 2024 – March 2025',
    text: 'Bioengineering capstone project building deep learning models (U-Net, Attention U-Net, and R2U-Net) to segment knee cartilage in quantitative DESS MRIs from the Stanford SKM-TEA dataset, so that segmentations could be paired with T2 maps to detect early cartilage degeneration.',
  },
  {
    title: 'Magnetoelastic Generators for Wearable Bioelectronics',
    org: 'UCLA Bioelectronics Research Lab, Dr. Jun Chen',
    orgUrl: 'https://www.junchenlab.com/',
    period: 'Oct 2022 – Oct 2024',
    text: 'Fabricated soft and liquid magnetoelastic generator (MEG) sensors from PDMS and NdFeB nanomagnets, and helped design a new 3D-printing method for manufacturing them. Tested sensor output for prosthetics feedback, voice recognition, and ambulatory cardiac monitoring, and presented at the UC Systemwide Bioengineering Symposium and UCLA Undergraduate Research Week in 2023.',
  },
];

const publications = [
  {
    title: 'A self-filtering liquid acoustic sensor for voice recognition',
    venue: 'Nature Electronics, 2024',
    url: 'https://doi.org/10.1038/s41928-024-01196-y',
  },
  {
    title: 'A reconfigurable and conformal liquid sensor for ambulatory cardiac monitoring',
    venue: 'Nature Communications, 2024',
    url: 'https://doi.org/10.1038/s41467-024-52462-8',
  },
];

const experience = [
  {
    title: 'Build Team Project Manager, UCLA BMES',
    period: 'Mar 2024 – Jun 2024',
    text: 'Led undergraduates in building their own pulse oximeters, teaching coding, circuits, CAD, PCB design, and soldering through weekly workshops and a course website. Managed over $1,500 in materials funding. Our poster won Best Introductory Poster Presentation at the BMES Technical Projects Symposium 2024.',
    url: 'https://bmesbuildteamucla.github.io/',
  },
  {
    title: 'Youth Mentorship Director, China Care Bruins',
    period: 'Sep 2021 – Present',
    text: 'Design and lead activities for 6th to 8th grade mentees in an organization that mentors youth adoptees from China in the LA area, fundraises for orphanages, and educates others about adoption.',
  },
  {
    title: 'Co-founder & Director, O-Chem Tutoring at UCLA',
    period: 'Jan 2023 – Mar 2024',
    text: 'Co-founded a free, student-run tutoring program for organic chemistry. Designed open-access worksheets and led weekly workshops of up to 30 students as the club grew to recruit more tutors and board directors.',
  },
  {
    title: 'Course Grader, UCLA Life Sciences Core Education',
    period: 'Oct 2022 – Apr 2025',
    text: 'Graded homework and coding labs for LS 30A & 30B: Mathematics for Life Scientists, working with professors and TAs to improve student learning.',
  },
  {
    title: 'Sustainability Volunteer, UCLA Alternative Breaks',
    period: 'Oct 2022 – Jun 2024',
    text: 'Volunteered on service trips to Seattle and Boston focused on sustainable farming, food systems, and the effects of climate change on farming and fishing.',
  },
];

const skills = [
  { group: 'CAD', items: ['Autodesk Fusion 360', 'SOLIDWORKS', 'Generative design'] },
  { group: 'Fabrication', items: ['FDM & SLA printing', 'TIG welding', 'Sand casting', 'Milling', 'Laser cutting', 'Woodworking'] },
  { group: 'Electrical', items: ['Analog sensing circuits', 'EAGLE PCB design', 'Soldering', 'Arduino', 'Servo control'] },
  { group: 'Software', items: ['React / JavaScript', 'Processing', 'Deep learning (U-Net segmentation)'] },
];
---

<Base title="About" description={`About ${site.name}`}>
  <section class="page">
    <div class="intro">
      <Image src={headshot} alt={`Portrait of ${site.name}`} width={320} class="headshot" />
      <div>
        <h1>About</h1>
        <div class="prose">
          <p>
            I'm an aspiring mechatronics engineer pursuing a Master's in Mechanical Engineering at
            Stanford, because I'm passionate about using technology to innovate healthcare and improve
            lives. I'm a firm believer in lifelong learning, and I'm excited to connect with others in
            the field who share that vision.
          </p>
          <p>
            Outside of engineering, I'm an avid participant in service and leadership. I also love
            being in nature through activities like backpacking. The best way to reach me is by
            <a href={`mailto:${site.email}`}>email</a>. Let's connect!
          </p>
        </div>

        <p class="links mono">
          {site.resume && <a href={site.resume}>resume ↗</a>}
          {site.cv && <a href={site.cv}>cv ↗</a>}
          <a href={site.linkedin}>linkedin ↗</a>
          <a href={site.scholar}>scholar ↗</a>
          <a href={site.github}>github ↗</a>
        </p>
      </div>
    </div>

    <div class="section">
      <div class="section-head">
        <h2 class="label">Research</h2>
      </div>
      <dl class="entries">
        {research.map((r) => (
          <div>
            <dt class="label">{r.period}</dt>
            <dd>
              <h3>{r.title}</h3>
              <p class="muted org"><a href={r.orgUrl}>{r.org}</a></p>
              <p>{r.text}</p>
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="section">
      <div class="section-head">
        <h2 class="label">Publications</h2>
      </div>
      <dl class="entries">
        {publications.map((p) => (
          <div>
            <dt class="label">{p.venue}</dt>
            <dd>
              <a href={p.url}>{p.title} ↗</a>
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="section">
      <div class="section-head">
        <h2 class="label">Leadership & teaching</h2>
      </div>
      <dl class="entries">
        {experience.map((e) => (
          <div>
            <dt class="label">{e.period}</dt>
            <dd>
              <h3>{e.url ? <a href={e.url}>{e.title} ↗</a> : e.title}</h3>
              <p>{e.text}</p>
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="section">
      <div class="section-head">
        <h2 class="label">Skills</h2>
      </div>
      <dl class="entries">
        {skills.map((s) => (
          <div>
            <dt class="label">{s.group}</dt>
            <dd>{s.items.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>

<style>
  .page {
    padding-top: 3.5rem;
  }

  .intro {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 2rem;
    align-items: start;
  }

  .headshot {
    width: 100%;
    height: auto;
    border-radius: 50%;
  }

  h1 {
    font-size: clamp(1.6rem, 4vw, 2.1rem);
    margin: 0 0 1.25rem;
  }

  .prose {
    max-width: 60ch;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.85rem;
  }

  .entries {
    margin: 0;
  }

  .entries > div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .entries dt {
    padding-top: 0.2rem;
  }

  .entries dd {
    margin: 0;
  }

  .entries h3 {
    font-size: 1rem;
    font-weight: 500;
    margin: 0;
  }

  .entries p {
    margin: 0.35rem 0 0;
    max-width: 62ch;
  }

  .entries .org {
    font-size: 0.9rem;
    margin-top: 0.1rem;
  }

  @media (max-width: 480px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .headshot {
      max-width: 8rem;
    }

    .entries > div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
